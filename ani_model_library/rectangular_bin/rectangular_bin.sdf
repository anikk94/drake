    <!-- ________________ Left wall ________________ -->
    <!-- size = 0.003 x 0.116 x 0.045, mass = 0.020 kg -->
    <link name="left_wall">
      <pose>-0.0715 0 0.0255 0 0 0</pose>

      <inertial>
        <mass>0.020</mass>
        <inertia>
          <ixx>4.0257e-06</ixx>
