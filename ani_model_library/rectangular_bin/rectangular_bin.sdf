<?xml version="1.0" ?>
<sdf version="1.10">
  <model name="open_box">
    <static>false</static>

    <!-- ________________ Bottom panel ________________ -->
    <!-- size = 0.146 x 0.122 x 0.003, mass = 0.080 kg -->
    <link name="bottom">
      <pose>0 0 0.0015 0 0 0</pose>

      <inertial>
        <mass>0.080</mass>
        <inertia>
          <ixx>2.4707e-05</ixx>
          <iyy>2.9645e-05</iyy>
          <izz>2.9565e-03</izz>
        </inertia>
      </inertial>

      <collision name="collision">
        <geometry><box><size>0.146 0.122 0.003</size></box></geometry>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.146 0.122 0.003</size></box></geometry>
        <material>
            <ambient>0.2 0.7 1.0 0.8</ambient>   <!-- RGBA, a = 0.4 → 60 % transparent -->
            <diffuse>0.2 0.7 .0 0.8</diffuse>
        </material>
      </visual>
    </link>

    <!-- ________________ Front wall ________________ -->
    <!-- size = 0.146 x 0.003 x 0.045, mass = 0.040 kg -->
    <link name="front_wall">
      <pose>0 -0.0595 0.0255 0 0 0</pose>

      <inertial>
