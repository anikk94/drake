      <visual name="visual">
        <geometry><box><size>0.146 0.003 0.045</size></box></geometry>
        <material>
  <ambient>0.2 0.7 1.0 0.4</ambient>   <!-- RGBA, a = 0.4 → 60 % transparent -->
  <diffuse>0.2 0.7 .0 0.4</diffuse>
</material>
